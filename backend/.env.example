# Local Docker development — copy to backend/.env (gitignored)
# Run: cp backend/.env.example backend/.env

ENVIRONMENT=development
DEBUG=true
APP_URL=http://localhost:8000

DATABASE_URL=postgresql://agent:agent@postgres:5432/agent_db?sslmode=disable
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:3000

# Required: set your OpenAI API key
OPENAI_API_KEY=

# Required: generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

JWT_SECRET_KEY=local-dev-jwt-secret-min-32-chars
AGENT_REPLY_DEBOUNCE_SECONDS=0

OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
